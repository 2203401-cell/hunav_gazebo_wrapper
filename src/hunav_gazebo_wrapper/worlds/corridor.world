<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="corridor_world">
    <!-- Basic lighting and physics for Gazebo Classic -->
    <include>
      <uri>model://sun</uri>
    </include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Corridor dimensions: inner width 2.0 m, length 10.0 m.
         Corridor runs along X; both ends are open. -->

    <!-- Floor slab: 10.2 m x 2.2 m, thickness 0.10 m; top surface at z=0. -->
    <model name="corridor_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box><size>10.2 2.2 0.1</size></box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box><size>10.2 2.2 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <pose>0 0 -0.05 0 0 0</pose>
      </link>
    </model>

    <!-- Left wall: inner face at y=-1.0; height 1.5 m, thickness 0.1 m. -->
    <model name="left_wall">
      <static>true</static>
      <pose>0 -1.05 0.75 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>10.0 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>10.0 0.1 1.5</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right wall: inner face at y=+1.0. -->
    <model name="right_wall">
      <static>true</static>
      <pose>0 1.05 0.75 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>10.0 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>10.0 0.1 1.5</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.82 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="corridor_camera">
        <pose>0 -8 6.5 0 0.55 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
